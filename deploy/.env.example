# Flashloan Contract Deployment - Environment Variables
# Copy this file to .env and fill in your values
# Usage: source .env && forge script script/DeployFlashloan.s.sol:DeployFlashloveScript --broadcast

# ============================================
# REQUIRED FOR DEPLOYMENT
# ============================================

# Your wallet private key (the deployer account)
# This account will be the owner of the contract
# Make sure it has at least 0.01 ETH on Arbitrum for gas
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Arbitrum One RPC URL (Alchemy)
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ============================================
# OPTIONAL - FOR CONTRACT VERIFICATION
# ============================================

# Arbiscan API key for automatic verification
# Get one at: https://arbiscan.io/myapikey
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY

# ============================================
# DEPLOYMENT SETTINGS (optional overrides)
# ============================================

# Custom initial owner (defaults to deployer address)
# INITIAL_OWNER=0xYourAddress

# ============================================
# ARBITRUM LIVE VALUES (DO NOT CHANGE)
# ============================================

# Aave V3 Pool
# AAVE_V3_POOL=0x794a61358D6845594F94dc1DB02A252b5b4814aD

# Aave V3 Addresses Provider  
# AAVE_V3_PROVIDER=0xa97684ead0e402dC232d5A977953DF7ECBaB3CDb
