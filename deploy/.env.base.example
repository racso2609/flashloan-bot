# Flashloan Arbitrage Bot - BASE Configuration
# Copy this file to .env and fill in your values

# ============================================
# WALLET CONFIGURATION
# ============================================

# Your wallet private key (NEVER share this!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ============================================
# NETWORK RPC URLS
# ============================================

# Base RPC URL (Coinbase public RPC or your own)
BASE_RPC_URL=https://mainnet.base.org

# Alternative RPCs:
# https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# https://base.rpcapi.quicknode.io/YOUR_KEY

# ============================================
# DEPLOYMENT INFO
# ============================================

# Basescan API key (for contract verification)
# Get one at: https://basescan.org/myapikey
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# Flashloan contract address (fill after deployment)
FLASHLOAN_CONTRACT=0xYOUR_CONTRACT_ADDRESS

# ============================================
# BOT SETTINGS
# ============================================

# Minimum profit in USD to execute trades
MIN_PROFIT_USD=1

# Maximum gas price in Gwei (Base gas is very cheap!)
MAX_GAS_PRICE_GWEI=0.5

# Polling interval in milliseconds
POLL_INTERVAL_MS=500

# Dry run mode
DRY_RUN=true

# Log level
LOG_LEVEL=warn
