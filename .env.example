# Flashloan Arbitrage Bot - Arbitrum Deployment & Configuration
# Copy this file to .env and fill in your values

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================

# Your wallet private key (NEVER share this!)
# Funds needed: ~0.01-0.02 ETH for gas on Arbitrum
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Arbiscan API key (for contract verification)
# Get one at: https://arbiscan.io/myapikey
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY

# ============================================
# NETWORK RPC URLS
# ============================================

# Arbitrum One RPC (use Alchemy, Infura, or your own node)
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Fallback RPC options:
# https://arb1.arbitrum.io/rpc
# https://arbitrum-one-rpc.publicnode.com
# https://1rpc.io/arb

# ============================================
# BOT CONFIGURATION
# ============================================

# Deployed contract address (fill after deployment)
FLASHLOAN_CONTRACT=0xYOUR_CONTRACT_ADDRESS

# Minimum profit in USD to execute trades
MIN_PROFIT_USD=5

# Maximum gas price in Gwei (Arbitrum gas is cheap!)
MAX_GAS_PRICE_GWEI=0.5

# Polling interval in milliseconds
POLL_INTERVAL_MS=2000

# Dry run mode (true = no real trades, just simulation)
DRY_RUN=true

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# ARBITRUM LIVE VALUES (DO NOT CHANGE)
# ============================================

# Aave V3 Addresses
AAVE_V3_POOL=0x794a61358D6845594F94dc1DB02A252b5b4814aD
