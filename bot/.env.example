# Flashloan Arbitrage Bot - Environment Variables
# Copy this file to .env and fill in your values

# Chain selection: arbitrum | base
CHAIN=arbitrum

# HTTP RPC URL
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# WebSocket RPC URL
ARBITRUM_WSS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BASE_WSS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Wallet
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
FLASHLOAN_CONTRACT=0xYOUR_CONTRACT_ADDRESS

# Bot Settings
MIN_PROFIT_USD=10
MAX_GAS_PRICE_GWEI=50
FLASHLOAN_AMOUNT=1000000000
POLL_INTERVAL_MS=3000
DRY_RUN=true
LOG_LEVEL=info
EXEC_GAS_UNITS=600000

# Aave V3 flashloan premium, in basis points. Defaults to 5 (0.05%), which is
# FLASHLOAN_PREMIUM_TOTAL on Arbitrum and Base. Only set this if the pool fee
# changes. The bot rounds the premium UP to match Aave's percentMulCeil.
AAVE_FLASHLOAN_PREMIUM_BPS=5

# Database (Postgres) - for metrics dashboard
DATABASE_URL=postgres://flashloan:flashloan@localhost:5432/flashloan_metrics
