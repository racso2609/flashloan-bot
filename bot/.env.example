# Flashloan Arbitrage Bot - Environment Variables
# Copy this file to .env and fill in your values

# Chain selection: arbitrum | base
CHAIN=arbitrum

# HTTP RPC URL (Alchemy, Infura, or other provider)
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# WebSocket RPC URL (optional but recommended). When set, the bot subscribes
# to new blocks instead of polling. Alchemy/QuickNode provide wss:// endpoints.
ARBITRUM_WSS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BASE_WSS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Your wallet private key (NEVER share this!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Your deployed Flashloan contract address
FLASHLOAN_CONTRACT=0xYOUR_CONTRACT_ADDRESS

# Bot Settings (optional, defaults are in config.js)
MIN_PROFIT_USD=10
MAX_GAS_PRICE_GWEI=50
FLASHLOAN_AMOUNT=1000000000
POLL_INTERVAL_MS=3000
DRY_RUN=true
LOG_LEVEL=info

# Conservative gas units for profit estimation (loan + 2 swaps + callback)
EXEC_GAS_UNITS=600000
