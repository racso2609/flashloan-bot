# Flashloan Arbitrage Bot - Environment Variables
# Copy this file to .env and fill in your values

# Ethereum RPC URL (Alchemy, Infura, or other provider)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Your wallet private key (NEVER share this!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Your deployed Flashloan contract address
FLASHLOAN_CONTRACT=0xYOUR_CONTRACT_ADDRESS

# Bot Settings (optional, defaults are in config.js)
MIN_PROFIT_USD=10
MAX_GAS_PRICE_GWEI=50
FLASHLOAN_AMOUNT=1000000000
POLL_INTERVAL_MS=3000
DRY_RUN=true
LOG_LEVEL=info
